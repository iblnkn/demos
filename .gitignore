# pixi environments
.pixi/*
!.pixi/config.toml
*.egg-info

# Python
*.pyc
__pycache__/

# Build output
build/*
install/*
log/*

# lerobot
logs
outputs

# vcs-imported source repos (kept under src/; in-tree packages live in src/pai/)
src/*
!src/pai/
!src/pai/**

# Legacy external repos directory (before src/ restructure)
external/

# Recorded datasets
datasets/*
datasets_lerobot/*

# Environment files
.env
.env.*

# Tool caches
node_modules/

# OS files
.DS_Store

# IDE (VS Code config is tracked; exclude others)
.idea/
*.swp
*.swo
